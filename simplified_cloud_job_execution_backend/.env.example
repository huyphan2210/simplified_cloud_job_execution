# Example environment variables for local Docker Compose
# Replace placeholder values with real values when deploying

# AWS credentials (use IAM roles / Secrets Manager in production)
AWS_ACCESS_KEY_ID=<YOUR_AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<YOUR_AWS_SECRET_ACCESS_KEY>
AWS_REGION=ap-southeast-1

# AWS resources
Sqs__QueueUrl=<https://sqs.<region>.amazonaws.com/<account-id>/<queue-name>>
S3__BucketName=<your-s3-bucket-name>
Ssm__InstanceId=<i-xxxxxxxxxxxxxxxxx>

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# Database connection string (example for local compose)
# For production, use Secrets Manager or environment-specific connection strings
ConnectionStrings__DefaultConnection=Host=db;Port=5432;Database=jobsystem;Username=appuser;Password=apppassword;SSL Mode=Disable
